{
  "cli": {
    "version": ">= 16.28.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "e2e": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "TRACKSY_ENABLE_TEST_ADAPTERS": "1"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  }
}
